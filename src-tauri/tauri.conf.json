{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diario Magicko Thelemico",
  "version": "1.0.0",
  "identifier": "com.diariomagicko.thelema",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Diário Mágicko Thelêmico — Liber Scientia",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
